{
  "name": "digital-public-administration-lab",
  "version": "0.1.0",
  "private": false,
  "description": "Single host for the Romanian civic project fleet: index, build-time mounts, and per-project proxy routes.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/mount-bureaucracy-as-code.mjs",
    "build:shell": "tsc -b && vite build",
    "build:functions": "wrangler pages functions build --outdir=.wrangler/functions-build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm build:functions",
    "smoke": "node scripts/smoke-dist.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.2.0",
    "lucide-react": "^0.542.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^16.5.0",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.131.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/CristianNichifor/digital-public-administration-lab.git"
  },
  "homepage": "https://digital.cristian-nichifor.com"
}

{
  "name": "digital-public-administration-lab",
  "version": "0.1.0",
  "private": false,
  "description": "Single host for the Romanian civic project fleet: index, build-time mounts, and per-project proxy routes.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "dev": "vite",
    "build": "pnpm build:shell && node scripts/mount-bureaucracy-as-code.mjs",
    "build:shell": "node scripts/refresh-freshness.mjs && tsc -b && vite build && vite build --ssr src/prerender.tsx --outDir .prerender && node .prerender/prerender.js",
    "build:functions": "wrangler pages functions build --outdir=.wrangler/functions-build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm build:functions",
    "smoke": "node scripts/smoke-dist.mjs && node scripts/verify-catalogue.mjs",
    "check:live": "node scripts/check-live-paths.mjs",
    "setup:sibling": "node scripts/setup-bureaucracy-as-code.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.2.0",
    "lucide-react": "^1.56.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^16.5.0",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.151.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/CristianNichifor/digital-public-administration-lab.git"
  },
  "homepage": "https://projects.cristian-nichifor.com/",
  "pnpm": {
    "overrides": {
      "undici@7.29.0": "7.29.1"
    }
  }
}
